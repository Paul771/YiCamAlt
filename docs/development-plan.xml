  <DataFlow>
    <DF-AUTH NAME="UserAuthentication" TRIGGER="User taps Login">
      <step-1>User enters credentials on LoginScreen (M-UI-LOGIN)</step-1>
      <step-2>M-AUTH validates credentials via M-HTTP (POST /v1/account/login)</step-2>
      <step-3>M-AUTH stores tokens in encrypted SharedPreferences</step-3>
      <step-4>AuthState updates to LOGGED_IN, navigation shifts to AppShell</step-4>
      <evidence>V-M-AUTH scenario-1 (success path), log marker [Auth][login][BLOCK_STORE_TOKEN]</evidence>
    </DF-AUTH>

    <DF-CAMERA-LIST NAME="CameraListFetch" TRIGGER="App launches or camera list refreshed">
      <step-1>M-CAMERA-LIST requests token from M-AUTH</step-1>
      <step-2>M-CAMERA-LIST calls cloud API via M-HTTP (GET /v1/user/camera/list)</step-2>
      <step-3>M-CAMERA-LIST parses response, caches in M-LOCAL-DB</step-3>
      <step-4>CameraRegistryState updates, UI refreshes</step-4>
      <evidence>V-M-CAMERA-LIST scenario-1 (success), log marker [Camera][getCameraList][BLOCK_FETCH_CAMERA_LIST]</evidence>
    </DF-CAMERA-LIST>

    <DF-LIVE-STREAM NAME="LiveViewConnection" TRIGGER="User taps camera thumbnail">
      <step-1>M-UI-LIVEVIEW requests stream from M-STREAM-LIVE</step-1>
      <step-2>M-STREAM-LIVE resolves stream URL via M-CAMERA-LIST.getLiveStreamUrl()</step-2>
      <step-3>M-STREAM-LIVE performs handshake via M-STREAM-DECODE to get AES key</step-3>
      <step-4>M-STREAM-DECODE creates decrypted MediaSource for ExoPlayer</step-4>
      <step-5>ExoPlayer initializes, video renders on surface</step-5>
      <step-6>Stream state reported back to UI (playing / error / reconnecting)</step-6>
      <evidence>V-M-STREAM-LIVE scenario-1 (full connect), log markers [Stream][startStream][BLOCK_CONNECT_STREAM], [Decode][handshake][BLOCK_HANDSHAKE]</evidence>
    </DF-LIVE-STREAM>

    <DF-EVENT-LIST NAME="EventTimelineLoad" TRIGGER="User navigates to Events tab">
      <step-1>M-UI-EVENTS requests events via M-EVENT</step-1>
      <step-2>M-EVENT fetches from cloud (GET /v1/camera/event/list) via M-HTTP</step-2>
      <step-3>M-EVENT caches to M-LOCAL-DB (syncEventsToDb)</step-3>
      <step-4>M-EVENT returns paginated events with thumbnails</step-4>
      <step-5>UI renders timeline</step-5>
      <evidence>V-M-EVENT scenario-1 (paginated list), log marker [Event][getEventTimeline][BLOCK_FETCH_EVENTS]</evidence>
    </DF-EVENT-LIST>

    <DF-PLAYBACK NAME="EventClipPlayback" TRIGGER="User taps event item">
      <step-1>M-UI-EVENTS sends eventId to M-UI-EVENTPLAYBACK</step-1>
      <step-2>M-EVENT-PLAYBACK resolves playback URL via M-EVENT.getPlaybackUrl()</step-2>
      <step-3>M-EVENT-PLAYBACK creates ExoPlayer MediaSource</step-3>
      <step-4>Video plays on surface with controls</step-4>
      <evidence>V-M-EVENT-PLAYBACK scenario-1 (playback success), log marker [Playback][startPlayback][BLOCK_INIT_PLAYER]</evidence>
    </DF-PLAYBACK>

    <DF-CMD-PTZ NAME="PTZControl" TRIGGER="User drags PTZ joystick">
      <step-1>M-UI-LIVEVIEW converts joystick delta to PTZ angles</step-1>
      <step-2>M-UI-LIVEVIEW calls M-CAMERA-CMD.sendPTZCommand()</step-2>
      <step-3>M-CAMERA-CMD sends via M-HTTP (POST /v1/camera/control)</step-3>
      <step-4>Camera acknowledges command</step-4>
      <evidence>V-M-CAMERA-CMD scenario-1 (PTZ success), log markers [CameraCmd][sendPTZ][BLOCK_SEND_COMMAND]</evidence>
    </DF-CMD-PTZ>

    <DF-PUSH-NOTIF NAME="PushNotificationDelivery" TRIGGER="Cloud sends push for motion event">
      <step-1>FCM delivers notification to M-PUSH (FirebaseMessagingService)</step-1>
      <step-2>M-PUSH parses payload, shows local notification</step-2>
      <step-3>User taps notification → deep link to event playback</step-3>
      <step-4>M-PUSH navigates to M-UI-EVENTPLAYBACK with eventId</step-4>
      <evidence>V-M-PUSH scenario-1 (push → playback), log marker [Push][handlePayload][BLOCK_SHOW_NOTIFICATION]</evidence>
    </DF-PUSH-NOTIF>

    <DF-CMD-CONFIG NAME="CameraConfiguration" TRIGGER="User renames camera in settings">
      <step-1>M-UI-SETTINGS sends rename request to M-CAMERA-CMD</step-1>
      <step-2>M-CAMERA-CMD sends command via M-HTTP</step-2>
      <step-3>Camera acknowledges, M-CAMERA-LIST updates device name</step-3>
      <evidence>V-M-CAMERA-CMD scenario-2 (config update), log marker [CameraCmd][sendCmd][BLOCK_SEND_COMMAND]</evidence>
    </DF-CMD-CONFIG>
  </DataFlow>

