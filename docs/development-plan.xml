<DevelopmentPlan VERSION="0.2.0">
  <ArchitectureNotes>
    <objective>Спроектировать модульную Android-архитектуру (Clean Architecture: data / domain / presentation) для альтернативного клиента Yi-камер. Каждый модуль должен иметь чёткий contract, measurable verification, и observable log markers.</objective>
    <non-goal>Не создавать server-side компонент; не делать iOS/桌面 версию; не поддерживать камеры не-Yi.</non-goal>
    <risk-1>Yi Cloud API может измениться без предупреждения — весь API-интерфейс инкапсулирован в M-HTTP с version-fallback layer.</risk-1>
    <risk-2>Видеопоток зашифрован AES-128 — ключи получаются через облачный handshake. M-STREAM-DECODE — самый рискованный модуль.</risk-2>
    <risk-3>Local RTSP discovery не работает из-за firewall NAT — требуется fallback к cloud relay.</risk-3>
  </ArchitectureNotes>

  <Modules>
    <!-- Layer 0: Foundation / Infrastructure -->

    <M-CONFIG NAME="Config" TYPE="UTILITY" LAYER="0" ORDER="1" STATUS="planned">
      <contract>
        <purpose>Central application configuration: feature flags, API base URLs, build variants, and runtime settings.</purpose>
        <inputs>
          <param name="applicationContext" type="Application" />
        </inputs>
        <outputs>
          <param name="ConfigModule" type="ConfigModule instance" />
        </outputs>
        <errors>
          <error code="CONFIG_MISSING_KEY" />
        </errors>
      </contract>
      <interface>
        <export-getApiBaseUrl PURPOSE="Return base URL for Yi Cloud API" />
        <export-getFeatureFlags PURPOSE="Return runtime feature flag map" />
        <export-isLocalRtspEnabled PURPOSE="Check if local RTSP is allowed by config" />
      </interface>
      <depends>none</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/config/ConfigModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/config/ConfigModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Config]</log-prefix>
        <critical-block>BLOCK_INIT_CONFIG</critical-block>
      </observability>
      <verification-ref>V-M-CONFIG</verification-ref>
      <notes>
        <note-1>Config values loaded from BuildConfig + default overrides. No network calls.</note-1>
      </notes>
    </M-CONFIG>

    <M-HTTP NAME="HttpClient" TYPE="UTILITY" LAYER="0" ORDER="2" STATUS="planned">
      <contract>
        <purpose>Shared HTTP client (OkHttp + Retrofit2) with TLS config, interceptors (auth header, logging), error mapping, and retry policy.</purpose>
        <inputs>
          <param name="configModule" type="ConfigModule" />
          <param name="authProvider" type="AuthProvider" />
        </inputs>
        <outputs>
          <param name="Retrofit instance" type="Retrofit" />
        </outputs>
        <errors>
          <error code="HTTP_TLS_FAILED" />
          <error code="HTTP_UNAUTHORIZED" />
        </errors>
      </contract>
      <interface>
        <export-createRetrofit PURPOSE="Build Retrofit with interceptors" />
        <export-getHttpClient PURPOSE="Return raw OkHttp client" />
        <export-setAuthToken PURPOSE="Update auth header via interceptor" />
      </interface>
      <depends>M-CONFIG</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/network/HttpClientModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/network/HttpClientModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Network]</log-prefix>
        <critical-block>BLOCK_INIT_HTTP_CLIENT</critical-block>
      </observability>
      <verification-ref>V-M-HTTP</verification-ref>
      <notes>
        <note-1>Auth header injected by AccessTokenInterceptor reading from M-AUTH token store.</note-1>
        <note-2>Response logs redact Authorization header and body on 4xx/5xx.</note-2>
      </notes>
    </M-HTTP>

    <M-LOCAL-DB NAME="LocalDatabase" TYPE="DATA_LAYER" LAYER="0" ORDER="3" STATUS="planned">
      <contract>
        <purpose>Room-based local persistence for event cache, config state, and offline playback manifest. Acts as a cache layer — source of truth is cloud, but DB ensures UI responsiveness.</purpose>
        <inputs>
          <param name="applicationContext" type="Application" />
        </inputs>
        <outputs>
          <param name="YiDatabase instance" type="Room database" />
        </outputs>
        <errors>
          <error code="DB_CORRUPTION" />
          <error code="DB_LOCKED" />
        </errors>
      </contract>
      <interface>
        <export-eventDao PURPOSE="Access event table operations" />
        <export-deviceDao PURPOSE="Access device registry operations" />
        <export-syncDao PURPOSE="Access sync status table" />
      </interface>
      <depends>M-CONFIG</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/database/YiDatabase.kt</source>
        <tests>app/src/test/java/com/yicamalt/database/LocalDatabaseTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Database]</log-prefix>
        <critical-block>BLOCK_INIT_DATABASE</critical-block>
      </observability>
      <verification-ref>V-M-LOCAL-DB</verification-ref>
    </M-LOCAL-DB>

    <!-- Layer 1: Core Domain -->

    <M-AUTH NAME="Authentication" TYPE="CORE_LOGIC" LAYER="1" ORDER="1" STATUS="planned">
      <contract>
        <purpose>Handle Yi Cloud authentication: login with email/password or phone, token refresh, session management, and secure storage of tokens in Android Keystore.</purpose>
        <inputs>
          <param name="email" type="String" />
          <param name="password" type="String" />
          <param name="loginMethod" type="AuthMethod (EMAIL / PHONE)" />
        </inputs>
        <outputs>
          <param name="AuthResult" type="AuthResult (Success | Error)" />
        </outputs>
        <errors>
          <error code="AUTH_INVALID_CREDENTIALS" />
          <error code="AUTH_TOKEN_EXPIRED" />
          <error code="AUTH_NETWORK_ERROR" />
        </errors>
      </contract>
      <interface>
        <export-login PURPOSE="Authenticate with Yi Cloud and store tokens" />
        <export-refreshToken PURPOSE="Refresh access token using refresh token" />
        <export-logout PURPOSE="Invalidate tokens and clear session" />
        <export-getAccessToken PURPOSE="Return current valid access token" />
        <export-isLoggedIn PURPOSE="Check if user has valid session" />
        <export-getAuthMethod PURPOSE="Return the auth method used for current session" />
      </interface>
      <depends>M-HTTP, M-LOCAL-DB</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/auth/AuthModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/auth/AuthModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Auth]</log-prefix>
        <critical-block>BLOCK_VALIDATE_CREDENTIALS, BLOCK_STORE_TOKEN, BLOCK_REFRESH_TOKEN</critical-block>
      </observability>
      <verification-ref>V-M-AUTH</verification-ref>
      <notes>
        <note-1>Tokens stored in EncryptedSharedPreferences backed by Android Keystore.</note-1>
        <note-2>Token refresh happens automatically before API calls via Retrofit interceptor.</note-2>
        <note-3>Reverse-engineered auth endpoint: POST /v1/account/login (based on Yi Home APK traffic).</note-3>
      </notes>
    </M-AUTH>

    <M-CAMERA-LIST NAME="CameraRegistry" TYPE="CORE_LOGIC" LAYER="1" ORDER="2" STATUS="planned">
      <contract>
        <purpose>Fetch and cache the list of user-attached Yi cameras from cloud API. Provides live list with device status (online/offline), model info, firmware version, and stream URL resolution.</purpose>
        <inputs>
          <param name="accessToken" type="String" />
        </inputs>
        <outputs>
          <param name="List&lt;CameraInfo&gt;" type="Camera entity list" />
        </outputs>
        <errors>
          <error code="CAMERA_FETCH_FAILED" />
          <error code="CAMERA_UNAUTHORIZED" />
        </errors>
      </contract>
      <interface>
        <export-getCameraList PURPOSE="Fetch camera list from cloud" />
        <export-getCameraById PURPOSE="Get single camera info by deviceId" />
        <export-getLiveStreamUrl PURPOSE="Resolve live stream URL (cloud or local) for a camera" />
        <export-updateCameraStatus PURPOSE="Update online/offline status (pushed from FCM)" />
        <export-cacheCameraList PURPOSE="Persist camera list to local DB for offline access" />
      </interface>
      <depends>M-HTTP, M-AUTH, M-LOCAL-DB</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/camera/CameraRegistryModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/camera/CameraRegistryModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Camera]</log-prefix>
        <critical-block>BLOCK_FETCH_CAMERA_LIST, BLOCK_RESOLVE_STREAM_URL</critical-block>
      </observability>
      <verification-ref>V-M-CAMERA-LIST</verification-ref>
      <notes>
        <note-1>Cloud endpoint: GET /v1/user/camera/list (reverse-engineered).</note-1>
        <note-2>Live stream URL format depends on camera model — need per-model resolver.</note-2>
      </notes>
    </M-CAMERA-LIST>

    <M-CAMERA-CMD NAME="CameraCommand" TYPE="CORE_LOGIC" LAYER="1" ORDER="3" STATUS="planned">
      <contract>
        <purpose>Send camera control commands: PTZ (pan/tilt), IR night vision toggle, sound speaker, capture photo, switch recording mode, firmware update check. Commands sent via cloud relay.</purpose>
        <inputs>
          <param name="deviceId" type="String" />
          <param name="command" type="CameraCommand" />
          <param name="params" type="Map&lt;String, Any&gt;" />
        </inputs>
        <outputs>
          <param name="CommandResult" type="CommandResult (Success | Error)" />
        </outputs>
        <errors>
          <error code="CMD_UNSUPPORTED_MODEL" />
          <error code="CMD_CAMERA_OFFLINE" />
          <error code="CMD_TIMEOUT" />
        </errors>
      </contract>
      <interface>
        <export-sendPTZCommand PURPOSE="Send PTZ rotation command" />
        <export-toggleIR PURPOSE="Toggle IR night vision" />
        <export-toggleSound PURPOSE="Toggle speaker / two-way audio" />
        <export-capturePhoto PURPOSE="Capture single photo from camera" />
        <export-setRecordingMode PURPOSE="Set SD/cloud recording mode" />
      </interface>
      <depends>M-HTTP, M-AUTH, M-CAMERA-LIST</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/camera/CameraCommandModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/camera/CameraCommandModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[CameraCmd]</log-prefix>
        <critical-block>BLOCK_VALIDATE_COMMAND, BLOCK_SEND_COMMAND, BLOCK_WAIT_ACK</critical-block>
      </observability>
      <verification-ref>V-M-CAMERA-CMD</verification-ref>
      <notes>
        <note-1>Commands sent via POST /v1/camera/control (reverse-engineered JSON protocol).</note-1>
        <note-2>PTZ coordinates: normalize joystick input to camera pan/tilt angles.</note-2>
      </notes>
    </M-CAMERA-CMD>

    <M-EVENT NAME="EventService" TYPE="CORE_LOGIC" LAYER="1" ORDER="4" STATUS="planned">
      <contract>
        <purpose>Fetch, cache, and manage motion/event timeline from Yi Cloud. Provides paginated event list with thumbnails, timestamps, and playback URLs. Events may come from cloud recording or SD-card.</purpose>
        <inputs>
          <param name="deviceId" type="String" />
          <param name="startTime" type="Long (epoch ms)" />
          <param name="endTime" type="Long (epoch ms)" />
          <param name="page" type="Int" />
        </inputs>
        <outputs>
          <param name="EventList" type="Paginated event list with thumbnails" />
        </outputs>
        <errors>
          <error code="EVENT_FETCH_FAILED" />
          <error code="EVENT_NO_RECORDING" />
        </errors>
      </contract>
      <interface>
        <export-getEventTimeline PURPOSE="Fetch paginated event list" />
        <export-getEventById PURPOSE="Get single event with full details" />
        <export-getPlaybackUrl PURPOSE="Resolve playback URL for an event" />
        <export-syncEventsToDb PURPOSE="Cache events to local Room database" />
        <export-getLocalEventCount PURPOSE="Count cached events for offline availability" />
      </interface>
      <depends>M-HTTP, M-AUTH, M-LOCAL-DB</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/event/EventServiceModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/event/EventServiceModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Event]</log-prefix>
        <critical-block>BLOCK_FETCH_EVENTS, BLOCK_SYNC_TO_DB, BLOCK_RESOLVE_PLAYBACK_URL</critical-block>
      </observability>
      <verification-ref>V-M-EVENT</verification-ref>
      <notes>
        <note-1>Cloud endpoint: GET /v1/camera/event/list (paginated with cursor).</note-1>
        <note-2>Event thumbnails are JPEG blobs returned inline; full video needs separate URL resolution.</note-2>
      </notes>
    </M-EVENT>

    <M-STREAM-LIVE NAME="LiveStream" TYPE="CORE_LOGIC" LAYER="1" ORDER="5" STATUS="planned">
      <contract>
        <purpose>Establish and manage live video stream from a Yi camera. Supports cloud relay stream and (optionally) local RTSP stream. Handles stream lifecycle (connect, buffer, play, disconnect), reconnection on network change, and quality adaptation.</purpose>
      <inputs>
          <param name="cameraId" type="String" />
          <param name="streamType" type="StreamType (CLOUD / LOCAL_RTSP)" />
          <param name="quality" type="StreamQuality (SD / HD)" />
        </inputs>
        <outputs>
          <param name="StreamHandle" type="StreamHandle (surface + state)" />
        </outputs>
        <errors>
          <error code="STREAM_CONNECTION_FAILED" />
          <error code="STREAM_DECODE_ERROR" />
          <error code="STREAM_REJECTED (access denied / subscription)" />
        </errors>
      </contract>
      <interface>
        <export-startStream PURPOSE="Initialize and connect to camera stream" />
        <export-stopStream PURPOSE="Gracefully disconnect stream" />
        <export-switchQuality PURPOSE="Switch SD/HD quality (requires reconnect)" />
        <export-getStreamState PURPOSE="Return StreamState (connecting | playing | error | stopped)" />
        <export-getLatencyMs PURPOSE="Return current measured latency in ms" />
        <export-getFps PURPOSE="Return current FPS" />
      </interface>
      <depends>M-HTTP, M-AUTH, M-CAMERA-LIST, M-STREAM-DECODE</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/stream/LiveStreamModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/stream/LiveStreamModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Stream]</log-prefix>
        <critical-block>BLOCK_CONNECT_STREAM, BLOCK_DECODE_FRAME, BLOCK_HANDLE_RECONNECT</critical-block>
      </observability>
      <verification-ref>V-M-STREAM-LIVE</verification-ref>
      <notes>
        <note-1>Cloud stream URL: /v1/camera/live/stream — returns encrypted media URL with session key.</note-1>
        <note-2>Local RTSP: rtsp://&lt;camera_ip&gt;/live — only works on same LAN, uses standard RTSP.</note-2>
        <note-3>Stream uses ExoPlayer with custom DataSource for encrypted HLS/HTTP stream.</note-3>
      </notes>
    </M-STREAM-LIVE>

    <M-STREAM-DECODE NAME="StreamDecoder" TYPE="CORE_LOGIC" LAYER="1" ORDER="6" STATUS="planned">
      <contract>
        <purpose>Handle video stream decryption and decoding. Decrypts AES-128 encrypted Yi camera streams using keys from the cloud handshake. Wraps ExoPlayer MediaSource with decryption support.</purpose>
        <inputs>
          <param name="encryptedStreamUrl" type="String" />
          <param name="aesKey" type="ByteArray" />
          <param name="iv" type="ByteArray" />
        </inputs>
        <outputs>
          <param name="DecryptedMediaSource" type="ExoPlayer MediaSource" />
        </outputs>
        <errors>
          <error code="DECRYPT_KEY_INVALID" />
          <error code="DECRYPT_AES_FAILED" />
          <error code="DECODE_H264_FAILED" />
        </errors>
      </contract>
      <interface>
        <export-createDecryptedSource PURPOSE="Create ExoPlayer MediaSource from encrypted URL + AES key" />
        <export-handshakeWithCamera PURPOSE="Perform handshake to obtain AES session key" />
        <export-validateKey PURPOSE="Verify AES key is valid before creating source" />
      </interface>
      <depends>M-HTTP</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/stream/StreamDecoderModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/stream/StreamDecoderModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Decode]</log-prefix>
        <critical-block>BLOCK_HANDSHAKE, BLOCK_AES_DECRYPT_INIT, BLOCK_CREATE_MEDIA_SOURCE</critical-block>
      </observability>
      <verification-ref>V-M-STREAM-DECODE</verification-ref>
      <notes>
        <note-1>Yi streams use AES-128-ECB or AES-128-CBC. Key derived from cloud handshake response.</note-1>
        <note-2>Handshake endpoint: POST /v1/camera/live/key (reverse-engineered — returns session key).</note-2>
        <note-3>This is the most reverse-engineering-heavy module. API surface may change.</note-3>
      </notes>
    </M-STREAM-DECODE>

    <M-EVENT-PLAYBACK NAME="EventPlayback" TYPE="CORE_LOGIC" LAYER="1" ORDER="7" STATUS="planned">
      <contract>
        <purpose>Playback of recorded event clips. Resolves playback URL (cloud CDN or local), manages download buffer, and delegates to ExoPlayer for video rendering.</purpose>
        <inputs>
          <param name="eventId" type="String" />
          <param name="playbackUrl" type="String" />
        </inputs>
        <outputs>
          <param name="PlaybackHandle" type="PlaybackHandle (surface + progress)" />
        </outputs>
        <errors>
          <error code="PLAYBACK_URL_FAILED" />
          <error code="PLAYBACK_DECODE_ERROR" />
        </errors>
      </contract>
      <interface>
        <export-startPlayback PURPOSE="Start playing an event clip" />
        <export-stopPlayback PURPOSE="Stop and release playback resources" />
        <export-seekTo PURPOSE="Seek to position (ms) in the event clip" />
        <export-getPlaybackDuration PURPOSE="Return total clip duration" />
        <export-getCurrentPosition PURPOSE="Return current playback position" />
      </interface>
      <depends>M-HTTP, M-AUTH, M-EVENT</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/event/EventPlaybackModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/event/EventPlaybackModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Playback]</log-prefix>
        <critical-block>BLOCK_RESOLVE_URL, BLOCK_INIT_PLAYER, BLOCK_PLAY_EVENT</critical-block>
      </observability>
      <verification-ref>V-M-EVENT-PLAYBACK</verification-ref>
    </M-EVENT-PLAYBACK>

    <M-PUSH NAME="PushService" TYPE="CORE_LOGIC" LAYER="1" ORDER="8" STATUS="planned">
      <contract>
        <purpose>Manage FCM (Firebase Cloud Messaging) push notifications: device token registration, notification handling (foreground / background / headless), deep-link to event playback, and fallback to local push channel management.</purpose>
        <inputs>
          <param name="deviceId" type="String" />
        </inputs>
        <outputs>
          <param name="PushState" type="PushState (registered | error)" />
        </outputs>
        <errors>
          <error code="PUSH_TOKEN_FAILED" />
          <error code="PUSH_PERMISSION_DENIED" />
        </errors>
      </contract>
      <interface>
        <export-registerDevice PURPOSE="Register device token with Yi Cloud and Firebase" />
        <export-handlePushPayload PURPOSE="Process incoming push notification data" />
        <export-showLocalNotification PURPOSE="Show Android notification for event alert" />
        <export-deepLinkFromPush PURPOSE="Navigate to event playback from push deep-link" />
        <export-unregisterDevice PURPOSE="Unregister from push service (logout)" />
      </interface>
      <depends>M-HTTP, M-AUTH, M-EVENT</depends>
      <target>
        <source>app/src/main/java/com/yicamalt/push/PushServiceModule.kt</source>
        <tests>app/src/test/java/com/yicamalt/push/PushServiceModuleTest.kt</tests>
      </target>
      <observability>
        <log-prefix>[Push]</log-prefix>
        <critical-block>BLOCK_REGISTER_TOKEN, BLOCK_HANDLE_PAYLOAD, BLOCK_SHOW_NOTIFICATION</critical-block>
      </observability>
      <verification-ref>V-M-PUSH</verification-ref>
      <notes>
        <note-1>Push payload contains: eventType (motion), deviceId, eventId, timestamp, thumbnailUrl.</note-1>
        <note-2>Yi Cloud sends push via Firebase (FCM) — need to register FCM token with Yi Cloud API.</note-2>
      </notes>
    </M-PUSH>

    <!-- Layer 2: UI / Presentation -->

